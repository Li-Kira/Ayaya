-- default.srp — Ayaya Engine Default Scriptable Render Pipeline
-- This script produces rendering identical to the hardcoded C++ pipeline.
-- Edit this file to customize the render pipeline without recompiling C++.
--
-- LightMode 体系 — 材质通过位掩码声明参与哪些渲染 pass：
--   内置位：  GBuffer(1)  ShadowCaster(2)  Forward(4)  DepthPrePass(8)
--   用户自定义位从 16 开始：16, 32, 64, 128
--   LightMode 参数接受逗号分隔字符串 ("GBuffer,ShadowCaster") 或自定义 Mask。

local vpW = Pipeline:GetViewportWidth()
local vpH = Pipeline:GetViewportHeight()

-- ==========================================
-- 1. Texture Declarations
--    Format names: R8, R32F, RGBA8, RG16F, RGBA16F, RGBA32F, Depth
--    Percentage sizing: use Lua arithmetic (vpW / 2, vpW * 0.25)
-- ==========================================

Pipeline:DeclareTexture("ShadowMap", {"Depth"}, 4096, 4096, 1, true)

Pipeline:DeclareTexture("GBuffer",
    {"RG16F", "RGBA8", "RGBA8", "RGBA8", "RG16F", "Depth"}, vpW, vpH)

Pipeline:DeclareTexture("SSAO_Final", {"R8"}, vpW / 2, vpH / 2)

Pipeline:DeclareTexture("Lighting", {"RGBA16F", "Depth"}, vpW, vpH)

Pipeline:DeclareTexture("SSR_Result", {"RGBA16F"}, vpW / 2, vpH / 2)

Pipeline:DeclareTexture("SSR_Blurred", {"RGBA16F"}, vpW / 2, vpH / 2)

Pipeline:DeclareTexture("SSR_Temporal", {"RGBA16F"}, vpW / 2, vpH / 2)

Pipeline:DeclareTexture("Selection", {"RGBA8"}, vpW, vpH)

Pipeline:DeclareTexture("WBOIT_Gather", {"RGBA16F", "RG16F"}, vpW, vpH)

Pipeline:DeclareTexture("Bloom", {"RGBA16F"}, vpW / 2, vpH / 2)

Pipeline:DeclareTexture("FinalOutput", {"RGBA8"}, vpW, vpH)

Pipeline:DeclareTexture("FXAA", {"RGBA8"}, vpW, vpH)

-- ==========================================
-- 2. Pass Declarations
--    Pipeline:AddPass(nodeName, passType, reads, writes, readWrites, params)
--
--    reads      = { "texture1", "texture2" }  — input textures (read-only)
--    writes     = { "texture1" }              — output textures (exclusive write)
--    readWrites = { "texture1" }              — accumulative read+write (e.g., Lighting)
--    params     = { Enabled = false, LightMode = "GBuffer", Queue = "Opaque" }
--
--    Topological order is derived from read/write dependencies automatically.
--    The order of AddPass calls does NOT matter.
-- ==========================================

-- Shadow Pass: renders depth from light's perspective
Pipeline:AddPass("Shadow", "ShadowPass", {}, {"ShadowMap"}, {},
    { LightMode = "ShadowCaster" })

-- GBuffer Pass: writes albedo, normal, PBR params, depth
Pipeline:AddPass("GBuffer", "GBufferPass", {}, {"GBuffer"}, {},
    { LightMode = "GBuffer", Queue = "Opaque" })

-- SSAO: Screen-Space Ambient Occlusion (disabled by default)
Pipeline:AddPass("SSAO", "SSAOPass", {"GBuffer"}, {"SSAO_Final"}, {},
    { Enabled = false })

-- Lighting Pass: deferred PBR lighting into HDR target
Pipeline:AddPass("Lighting", "LightingPass",
    {"GBuffer", "ShadowMap", "SSAO_Final"}, {"Lighting"}, {})

-- SSR: screen-space reflections (ray march in view space, half-res)
Pipeline:AddPass("SSR", "SSRPass",
    {"SceneDepth", "GBuffer", "Lighting"}, {"SSR_Result"}, {},
    { Enabled = false })

-- SSR Blur: roughness-driven bilateral blur on SSR_Result
Pipeline:AddPass("SSRBlur", "SSRBlurPass",
    {"SSR_Result", "GBuffer", "SceneDepth"}, {"SSR_Blurred"}, {},
    { Enabled = false })

-- SSR Temporal: temporal reprojection + roughness-adaptive blend + neighborhood clamp
-- Reads per-object velocity from GBuffer attachment 4 (UE5-style motion vector)
Pipeline:AddPass("SSRTemporal", "SSRTemporalPass",
    {"SSR_Blurred", "SceneDepth", "GBuffer"}, {"SSR_Temporal"}, {},
    { Enabled = false })

-- Apply Reflection: UE-style hierarchical SSR/IBL specular replacement.
-- Reads SSR_Temporal (temporally stable) instead of raw SSR_Blurred.
-- Computes specular: SSR on hit, IBL cubemap on miss, roughness-controlled transition.
-- LoadOps={Lighting="LOAD"} preserves existing Lighting (diffuse + direct specular + IBL diffuse).
Pipeline:AddPass("ApplyReflection", "ApplyReflection",
    {"SSR_Temporal", "GBuffer", "SceneDepth", "SSAO_Final"}, {"Lighting"}, {},
    { Enabled = false, LoadOps = { Lighting = "LOAD" } })

-- Forward Blend: skybox + grid + sprites overlaid onto Lighting HDR (LOAD overlay)
Pipeline:AddPass("ForwardBlend", "ForwardBlend", {}, {"Lighting"}, {},
    { LightMode = "Forward" })

-- WBOIT Gather: weighted blended order-independent transparency (accumulation)
Pipeline:AddPass("WBOIT_Gather", "WBOIT_Gather",
    {"GBuffer"}, {"WBOIT_Gather"}, {},
    { Queue = "Translucent" })

-- WBOIT Resolve: composite translucent accumulation onto Lighting HDR
Pipeline:AddPass("WBOIT_Resolve", "WBOIT_Resolve",
    {"WBOIT_Gather"}, {}, {"Lighting"})

-- Outline Pass: selection highlight mask
Pipeline:AddPass("Outline", "OutlinePass", {"GBuffer"}, {"Selection"}, {},
    { Enabled = true })

-- Bloom Pass: emissive bloom from HDR (disabled by default)
Pipeline:AddPass("Bloom", "BloomPass", {"Lighting"}, {"Bloom"}, {},
    { Enabled = false })

-- Post Process: tone mapping, exposure, selection outline composite
Pipeline:AddPass("PostProcess", "PostProcessPass",
    {"Lighting", "Selection", "Bloom"}, {"FinalOutput"}, {})

-- FXAA: anti-aliasing
Pipeline:AddPass("FXAA", "FXAAPass", {"FinalOutput"}, {"FXAA"}, {})

-- UI Pass: editor UI composited on top of FXAA output
Pipeline:AddPass("UI", "UIPass", {}, {}, {"FXAA"})

-- ==========================================
-- 3. Output
-- ==========================================
Pipeline:SetOutput("FXAA")
