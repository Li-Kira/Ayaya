#version 450 core
#extension GL_EXT_shader_atomic_int64 : enable   // silently ignored if unsupported

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ── Input: instance & geometry data (set=2, shared GDRContext) ──
struct GPUInstance {
    mat4 transform;
    mat4 prevTransform;
    vec4 boundingSphere;   // xyz=center, w=radius
    uint geometryRangeIdx;
    uint materialIdx;
    uint entityId;
    uint flags;
};
layout(std430, set = 2, binding = 0) readonly buffer InstanceBuffer {
    GPUInstance Instances[];
};

struct GeometryRange {
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint indexCount;
};
layout(std430, set = 2, binding = 1) readonly buffer GeometryRangeBuffer {
    GeometryRange Ranges[];
};

struct GPUMaterial {
    vec4 albedo;
    float metallic, roughness, ao, alpha;
    int useAlbedoMap, useNormalMap, useORMMap;
    int useMetallicMap, useRoughnessMap, useAOMap;
    int albedoBindless, normalBindless, ormBindless;
    int metallicBindless, roughnessBindless, aoBindless;
    float alphaCutoff;
    int blendMode;
    int useAlphaMap;
    int alphaBindless;
    uint lightModeMask;
    uint packing; uint _pad1, _pad2;  // align customData to 16-byte boundary (match C++ alignas(16))
    float customData[16];
};
layout(std430, set = 2, binding = 2) readonly buffer MaterialBuffer {
    GPUMaterial Materials[];
};

// ── Output: indirect draw commands ──
struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

// set=3, binding=0: Opaque indirect commands (both paths)
layout(std430, set = 3, binding = 0) buffer OpaqueCommands {
    DrawCommand OpaqueCmds[];
};

#ifdef USE_INDIRECT_COUNT
// ── Atomic path: compacted binning with count buffers ──
// Set=3, binding=1: Opaque atomic count
layout(std430, set = 3, binding = 1) buffer OpaqueCount {
    uint OpaqueCnt;
};
// Set=3, binding=2: Masked indirect commands
layout(std430, set = 3, binding = 2) buffer MaskedCommands {
    DrawCommand MaskedCmds[];
};
// Set=3, binding=3: Masked atomic count
layout(std430, set = 3, binding = 3) buffer MaskedCount {
    uint MaskedCnt;
};
#else
// ── Fixed-slot path: contiguous bindings (MoltenVK/Metal compat) ──
// Set=3, binding=1: Masked indirect commands
layout(std430, set = 3, binding = 1) buffer MaskedCommands {
    DrawCommand MaskedCmds[];
};
#endif

// ── Push constants: light frustum planes (Gribb-Hartmann, 6 × vec4 = 96 bytes) + instance count ──
layout(push_constant) uniform FrustumPC {
    vec4 u_Planes[6];
    uint u_InstanceCount;
    uint u_LightModeMask;
} pc;

bool IsVisible(vec4 sphere) {
    for (int i = 0; i < 6; i++) {
        if (dot(pc.u_Planes[i].xyz, sphere.xyz) + pc.u_Planes[i].w < -sphere.w)
            return false;
    }
    return true;
}

const uint kFlag_CastShadows = 1u;

void main() {
    uint gID = gl_GlobalInvocationID.x;
    if (gID >= pc.u_InstanceCount) return;

    GPUInstance inst = Instances[gID];

    // Pre-initialize zeroed no-op command. ALL skip paths MUST write the
    // ENTIRE struct — MoltenVK indirect draws read every field; stale
    // indexCount/firstIndex from previous frames cause black rectangles.
    DrawCommand zeroCmd;
    zeroCmd.indexCount = 0;
    zeroCmd.instanceCount = 0;
    zeroCmd.firstIndex = 0;
    zeroCmd.vertexOffset = 0;
    zeroCmd.firstInstance = 0;

    // Skip non-shadow-casters
    if ((inst.flags & kFlag_CastShadows) == 0u) {
#ifndef USE_INDIRECT_COUNT
        OpaqueCmds[gID] = zeroCmd;
        MaskedCmds[gID] = zeroCmd;
#endif
        return;
    }

    if (IsVisible(inst.boundingSphere)) {
        GeometryRange range = Ranges[inst.geometryRangeIdx];
        GPUMaterial mat = Materials[inst.materialIdx];

        // LightMode mask check (GPU routing — zero CPU cost)
        if ((mat.lightModeMask & pc.u_LightModeMask) == 0u) {
#ifndef USE_INDIRECT_COUNT
            OpaqueCmds[gID] = zeroCmd;
            MaskedCmds[gID] = zeroCmd;
#endif
            return;
        }

        DrawCommand cmd;
        cmd.indexCount    = range.indexCount;
        cmd.instanceCount = 1;
        cmd.firstIndex    = range.indexOffset / 4u;
        cmd.vertexOffset  = 0;
        cmd.firstInstance = gID;

#ifdef USE_INDIRECT_COUNT
        // ── Atomic-compacted binning ──
        if (mat.blendMode == 1) {
            uint idx = atomicAdd(MaskedCnt, 1u);
            MaskedCmds[idx] = cmd;
        } else {
            uint idx = atomicAdd(OpaqueCnt, 1u);
            OpaqueCmds[idx] = cmd;
        }
#else
        // ── Fixed-slot binning (MoltenVK/M1 compatible) ──
        if (mat.blendMode == 1) {
            MaskedCmds[gID] = cmd;
            OpaqueCmds[gID] = zeroCmd;
        } else {
            OpaqueCmds[gID] = cmd;
            MaskedCmds[gID] = zeroCmd;
        }
#endif
    }
#ifndef USE_INDIRECT_COUNT
    else {
        // Frustum-culled: zero BOTH bins
        OpaqueCmds[gID] = zeroCmd;
        MaskedCmds[gID] = zeroCmd;
    }
#endif
}
