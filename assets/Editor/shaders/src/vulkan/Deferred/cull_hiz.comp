#version 450

// Hi-Z Occlusion Culling — Temporal (Previous-Frame Hi-Z)
// Runs AFTER frustum cull (cull.comp), reads the same IndirectBuffer.
// For each surviving instance: projects bounding sphere to PREVIOUS frame's
// screen space, computes nearest depth in View Space, samples Hi-Z at the
// appropriate mip level, and sets instanceCount=0 if fully occluded.
//
// Rules:
//  1. Use PREVIOUS frame's View/Proj matrices (coordinate alignment)
//  2. Compute nearest depth in View Space (linear), then project to NDC
//  3. Hi-Z image is ring-buffered per frame-in-flight to avoid WAW hazards

layout(local_size_x = 64) in;

// ── Set 2: Shared GDR data (read-only) ──
struct GPUInstance {
    mat4 transform;
    vec4 boundingSphere;
    uint geometryRangeIdx;
    uint materialIdx;
    uint entityId;
    uint flags;
};
layout(std430, set = 2, binding = 0) readonly buffer InstanceBuffer {
    GPUInstance Instances[];
};

struct GeometryRange {
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint indexCount;
};
layout(std430, set = 2, binding = 1) readonly buffer GeometryRangeBuffer {
    GeometryRange Ranges[];
};

// ── Set 3: Indirect draw buffer (read-modify-write from frustum cull) ──
struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    uint vertexOffset;
    uint firstInstance;
};
layout(std430, set = 3, binding = 0) buffer DrawIndirectBuffer {
    DrawCommand Commands[];
};

// ── Set 4: Hi-Z depth pyramid from PREVIOUS frame ──
// NEAREST sampler: we want exact texel values, not interpolation
layout(set = 4, binding = 0) uniform sampler2D u_HiZTexture;

// ── Push Constants ──
layout(push_constant) uniform HiZPC {
    mat4 u_PrevView;        // previous frame VIEW matrix
    mat4 u_PrevProj;        // previous frame PROJECTION matrix
    uint u_InstanceCount;
    uint u_HiZMipCount;
} pc;

void main() {
    uint gID = gl_GlobalInvocationID.x;
    if (gID >= pc.u_InstanceCount) return;

    // Skip already-culled instances (frustum pass set instanceCount=0)
    if (Commands[gID].instanceCount == 0) return;

    GPUInstance inst = Instances[gID];
    vec3 center = inst.boundingSphere.xyz;
    float radius = inst.boundingSphere.w;

    // ── 1. Project to PREVIOUS frame's clip space ──
    mat4 prevVP = pc.u_PrevProj * pc.u_PrevView;
    vec4 prevClip = prevVP * vec4(center, 1.0);

    // Outside previous frustum → conservatively keep (don't have depth data)
    if (prevClip.w <= 0.0) return;
    if (abs(prevClip.x) > abs(prevClip.w) || abs(prevClip.y) > abs(prevClip.w)) return;

    // ── 2. Compute nearest depth in View Space (linear) ──
    // Vulkan view space: camera looks along -Z, so +z = closer to camera.
    vec4 viewPos = pc.u_PrevView * vec4(center, 1.0);
    vec3 nearestView = viewPos.xyz;
    nearestView.z += radius;  // pull sphere toward camera → more conservative

    vec4 nearestClip = pc.u_PrevProj * vec4(nearestView, 1.0);
    if (nearestClip.w <= 0.0) return; // sphere hits near plane — conservatively keep
    float instanceDepth = nearestClip.z / nearestClip.w;  // [0, 1] Vulkan NDC

    // Clamp to valid depth range
    instanceDepth = clamp(instanceDepth, 0.0, 1.0);

    // If instance is at or very near the near plane, conservatively keep it.
    // Floating-point error in nearestClip.z / nearestClip.w amplifies when w is small,
    // producing inflated depths that incorrectly fail the occlusion test.
    if (instanceDepth <= 1e-4) return;

    // ── 3. Analytic screen-space AABB (exact sphere projection) ──
    // Computes the true min/max NDC bounds of the projected sphere via the
    // tangent-cone intersection with the Z=1 image plane.  Accounts for
    // perspective distortion (projected center ≠ sphere-center projection)
    // that radius/w approximations miss for close, off-axis spheres.
    vec3 C = viewPos.xyz;
    float R = radius;
    float d2 = dot(C, C);
    float r2 = R * R;
    if (d2 <= r2 || C.z * C.z <= r2) return; // camera in/near sphere — keep

    float z2 = C.z * C.z;
    float x2 = C.x * C.x;
    float y2 = C.y * C.y;

    float tx = sqrt(x2 + z2 - r2);
    float minX = (C.x * C.z - R * tx) / (z2 - r2);
    float maxX = (C.x * C.z + R * tx) / (z2 - r2);

    float ty = sqrt(y2 + z2 - r2);
    float minY = (C.y * C.z - R * ty) / (z2 - r2);
    float maxY = (C.y * C.z + R * ty) / (z2 - r2);

    // NDC bounds with correct Vulkan sign (clip.w = -View.z)
    vec2 ndcMin = -vec2(minX, minY) * vec2(pc.u_PrevProj[0][0], pc.u_PrevProj[1][1]);
    vec2 ndcMax = -vec2(maxX, maxY) * vec2(pc.u_PrevProj[0][0], pc.u_PrevProj[1][1]);
    vec2 trueNdcMin = min(ndcMin, ndcMax);
    vec2 trueNdcMax = max(ndcMin, ndcMax);

    // Convert to UV, apply Y-flip, re-order
    vec2 uvMin = trueNdcMin * 0.5 + 0.5;
    vec2 uvMax = trueNdcMax * 0.5 + 0.5;
    uvMin.y = 1.0 - uvMin.y;
    uvMax.y = 1.0 - uvMax.y;
    vec2 trueUvMin = min(uvMin, uvMax);
    vec2 trueUvMax = max(uvMin, uvMax);

    vec2 uvHalfSize = (trueUvMax - trueUvMin) * 0.5;
    vec2 screenUV   = (trueUvMin + trueUvMax) * 0.5;

    // ── Pixel-space mip selection ──
    vec2 viewportSize = vec2(textureSize(u_HiZTexture, 0));
    vec2 rectSizePixels = uvHalfSize * 2.0 * viewportSize;
    float mip = max(0.0, floor(log2(max(rectSizePixels.x, rectSizePixels.y))) - 1.0);
    mip = min(mip, float(pc.u_HiZMipCount - 1u));

    // ── 9-tap grid MAX sampling (center + 4 edges + 4 corners) ──
    vec2 e = uvHalfSize * 0.9;
    float bias = 0.01 + 0.01 * mip;

    vec2 taps[9] = {
        clamp(screenUV, 0.0, 1.0),                                // center
        clamp(screenUV + vec2(-e.x, 0.0), 0.0, 1.0),             // left
        clamp(screenUV + vec2( e.x, 0.0), 0.0, 1.0),             // right
        clamp(screenUV + vec2(0.0, -e.y), 0.0, 1.0),             // top
        clamp(screenUV + vec2(0.0,  e.y), 0.0, 1.0),             // bottom
        clamp(screenUV + vec2(-e.x, -e.y), 0.0, 1.0),            // top-left
        clamp(screenUV + vec2( e.x, -e.y), 0.0, 1.0),            // top-right
        clamp(screenUV + vec2(-e.x,  e.y), 0.0, 1.0),            // bottom-left
        clamp(screenUV + vec2( e.x,  e.y), 0.0, 1.0),            // bottom-right
    };

    float maxHizDepth = 0.0;
    for (int i = 0; i < 9; i++)
        maxHizDepth = max(maxHizDepth, textureLod(u_HiZTexture, taps[i], mip).r);

    if (instanceDepth > maxHizDepth + bias) {
        Commands[gID].instanceCount = 0u;
    }
}
