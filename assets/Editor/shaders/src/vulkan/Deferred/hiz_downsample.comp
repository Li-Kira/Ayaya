#version 450

// Hi-Z Depth Pyramid — 2×2 MAX Downsample
// Reads source mip level, writes the next (half-resolution) mip level.
// MAX reduction is correct for Standard-Z (Vulkan [0,1], 0=near, 1=far):
// each mip stores "furthest depth in this 2×2 region" — a conservative
// occluder that keeps objects visible unless fully behind.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D u_SrcMip;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D u_DstMip;

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    vec2 dstSize = vec2(imageSize(u_DstMip));
    if (uv.x >= int(dstSize.x) || uv.y >= int(dstSize.y)) return;

    ivec2 srcUV = uv * 2;
    float d0 = texelFetchOffset(u_SrcMip, srcUV, 0, ivec2(0, 0)).r;
    float d1 = texelFetchOffset(u_SrcMip, srcUV, 0, ivec2(1, 0)).r;
    float d2 = texelFetchOffset(u_SrcMip, srcUV, 0, ivec2(0, 1)).r;
    float d3 = texelFetchOffset(u_SrcMip, srcUV, 0, ivec2(1, 1)).r;

    float maxDepth = max(max(d0, d1), max(d2, d3));
    imageStore(u_DstMip, uv, vec4(maxDepth));
}
