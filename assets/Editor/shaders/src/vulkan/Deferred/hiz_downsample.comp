#version 450

// Hi-Z Depth Pyramid — 2×2 MAX Downsample (adaptive boundary-safe)
// Reads source mip level, writes the next (half-resolution) mip level.
// MAX reduction is correct for Standard-Z (Vulkan [0,1], 0=near, 1=far):
// each mip stores "furthest depth in this region" — a conservative
// occluder that keeps objects visible unless fully behind.
//
// Dynamic boundary handling: fixed 2×2 texelFetchOffset would skip the
// rightmost/bottommost pixel rows when the source mip has odd dimensions.
// The adaptive loop extends the sampling range at edges to capture every
// source pixel, preventing occlusion data loss at odd-resolution mip levels.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D u_SrcMip;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D u_DstMip;

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(u_DstMip);
    if (uv.x >= dstSize.x || uv.y >= dstSize.y) return;

    ivec2 srcSize = textureSize(u_SrcMip, 0);
    ivec2 base = uv * 2;

    // Adaptive boundary: if this is the last destination pixel, consume
    // all remaining source pixels (handles odd-resolution edge collapse)
    int maxX = (uv.x == dstSize.x - 1) ? (srcSize.x - 1) : (base.x + 1);
    int maxY = (uv.y == dstSize.y - 1) ? (srcSize.y - 1) : (base.y + 1);

    float maxDepth = 0.0;
    for (int y = base.y; y <= maxY; ++y)
        for (int x = base.x; x <= maxX; ++x)
            maxDepth = max(maxDepth, texelFetch(u_SrcMip, ivec2(x, y), 0).r);

    imageStore(u_DstMip, uv, vec4(maxDepth));
}
