-- testSRP — Scriptable Render Pipeline

local vpW = Pipeline:GetViewportWidth()
local vpH = Pipeline:GetViewportHeight()

Pipeline:DeclareTexture("ShadowMap", {"Depth"}, 4096, 4096, 1, true)
Pipeline:DeclareTexture("SceneDepth", {"R8", "Depth"}, vpW, vpH)
Pipeline:DeclareTexture("GBuffer",
    {"RG16F", "RGBA8", "RGBA8", "RGBA8", "RG16F"}, vpW, vpH)
Pipeline:DeclareTexture("SSAO_Final", {"R8"}, vpW / 2, vpH / 2)
Pipeline:DeclareTexture("Lighting", {"RGBA16F", "Depth"}, vpW, vpH)
Pipeline:DeclareTexture("Selection", {"RGBA8"}, vpW, vpH)
Pipeline:DeclareTexture("WBOIT_Gather", {"RGBA16F", "RG16F"}, vpW, vpH)
Pipeline:DeclareTexture("Bloom", {"RGBA16F"}, vpW / 2, vpH / 2)
Pipeline:DeclareTexture("FinalOutput", {"RGBA8"}, vpW, vpH)
Pipeline:DeclareTexture("FXAA", {"RGBA8"}, vpW, vpH)
Pipeline:DeclareTexture("WaterSurface", {"RGBA16F"}, vpW, vpH)

-- Depth Pre-pass (SceneDepth for hardcoded pipeline Early-Z; SRP GBuffer is self-contained)
Pipeline:AddPass("DepthPrePass", "DepthPrePass", {}, {"SceneDepth"}, {},
    { LightMode = "GBuffer", Queue = "Opaque" })

-- Shadow
Pipeline:AddPass("Shadow", "ShadowPass", {}, {"ShadowMap"}, {},
    { LightMode = "ShadowCaster" })

-- GBuffer: SceneDepth as depth attachment → readWrite (LOAD pre-pass depth)
Pipeline:AddPass("GBuffer", "GBufferPass",
    {"SceneDepth"}, {"GBuffer"}, {"SceneDepth"},
    { LightMode = "GBuffer", Queue = "Opaque",
      ClearColor = true, ClearDepth = false,
      DepthTest = true, DepthWrite = true, DepthFunc = 1 })

-- TestOpaque: custom opaque into GBuffer (self-contained depth)
Pipeline:AddPass("TestOpaque", "GenericDrawPass", {}, {}, {"GBuffer"},
    { Shader = "test_opaque", LightMode = "TestOpaque", Queue = "Opaque",
      Target = "GBuffer", DepthTarget = "SceneDepth",
      ClearColor = false, ClearDepth = false,
      DepthTest = true, DepthWrite = true, DepthFunc = 0,
      BlendMode = 0, CullMode = 0 })

-- SSAO
Pipeline:AddPass("SSAO", "SSAOPass",
    {"GBuffer", "SceneDepth"}, {"SSAO_Final"}, {},
    { Enabled = false })

-- Deferred Lighting — reads SceneDepth for depth reconstruction
Pipeline:AddPass("Lighting", "LightingPass",
    {"GBuffer", "ShadowMap", "SSAO_Final", "SceneDepth"}, {"Lighting"}, {})

-- Forward Blend — readWrite (LOAD + overlay skybox/grid onto Lighting)
Pipeline:AddPass("ForwardBlend", "ForwardBlend",
    {}, {}, {"Lighting"},
    { LightMode = "Forward" })

-- Water: Gerstner surface → WaterSurface (reads scene color + depth + IBL)
Pipeline:AddPass("Water", "GenericDrawPass", {"SceneDepth", "Lighting"}, {"WaterSurface"}, {},
    { Shader = "water", LightMode = "Water", Queue = "Transparent",
      Target = "WaterSurface",
      ClearColor = true, DepthTest = false, DepthWrite = false, BlendMode = 0, CullMode = 0,
      ReadSceneColor = true, ReadSceneDepth = true, ReadIBL = true })

-- Water composite → Lighting (alpha blend).
-- Uses the default GLSL generic_fullscreen.vert (Y-up) + a no-flip PS.
Pipeline:AddPass("WaterComposite", "GenericFullScreenPass", {"WaterSurface"}, {}, {"Lighting"},
    { Shader = "water_composite.frag", Target = "Lighting", ClearColor = false, BlendMode = 2, Texture0 = "WaterSurface" })

-- WBOIT
Pipeline:AddPass("WBOIT_Gather", "WBOIT_Gather",
    {"GBuffer", "SceneDepth"}, {"WBOIT_Gather"}, {},
    { Queue = "Translucent", Enabled = false })
Pipeline:AddPass("WBOIT_Resolve", "WBOIT_Resolve",
    {"WBOIT_Gather"}, {}, {"Lighting"}, { Enabled = false })

-- Outline
Pipeline:AddPass("Outline", "OutlinePass", {"GBuffer"}, {"Selection"}, {},
    { Enabled = false })

-- Bloom
Pipeline:AddPass("Bloom", "BloomPass", {"Lighting"}, {"Bloom"}, {},
    { Enabled = false })

-- PostProcess
Pipeline:AddPass("PostProcess", "PostProcessPass",
    {"Lighting", "Selection", "Bloom"}, {"FinalOutput"}, {})

-- Hologram: transparent overlay
Pipeline:AddPass("Hologram", "GenericDrawPass", {}, {}, {"FinalOutput"},
    { Shader = "hologram", LightMode = "Hologram", Queue = "Transparent",
      Target = "FinalOutput", ClearColor = false,
      DepthTest = false, DepthWrite = false, BlendMode = 1, CullMode = 0 })

-- FXAA
Pipeline:AddPass("FXAA", "FXAAPass", {"FinalOutput"}, {"FXAA"}, {})

-- UI
Pipeline:AddPass("UI", "UIPass", {}, {}, {"FXAA"})

-- Compute test
Pipeline:AddPass("ComputeTest", "GenericComputePass", {}, {}, {},
    { Shader = "Custom/test_compute.comp", DispatchX = 1, DispatchY = 1, DispatchZ = 1 })

Pipeline:SetOutput("FXAA")
