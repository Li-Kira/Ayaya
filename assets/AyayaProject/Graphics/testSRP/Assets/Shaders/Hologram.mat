MaterialName: Hologram
ShaderName: Default
BlendMode: 3
AlphaCutoff: 0.5
LightModes: "Hologram"
Properties:
  - UniformName: _Color
    DisplayName: Hologram Color
    Type: 5
    Vec4Value: [0, 1, 1, 0.5]
  - UniformName: _ScanSpeed
    DisplayName: Scan Speed
    Type: 0
    FloatValue: 0
  - UniformName: u_Alpha
    DisplayName: Alpha Multiplier
    Type: 0
    FloatValue: 1
  - UniformName: u_AlphaMap
    DisplayName: Alpha/Opacity Map
    Type: 8
    TextureHandle: 0
  - UniformName: u_ORMMap
    DisplayName: ORM Texture (R=AO G=Roughness B=Metallic)
    Type: 8
    TextureHandle: 0
  - UniformName: u_HeightMap
    DisplayName: Height/Displacement Map
    Type: 8
    TextureHandle: 0
  - UniformName: u_EmissiveMap
    DisplayName: Emissive Map
    Type: 8
    TextureHandle: 0