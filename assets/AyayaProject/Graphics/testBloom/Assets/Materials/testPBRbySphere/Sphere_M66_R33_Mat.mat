MaterialName: Sphere_M66_R33_Mat
ShaderName: PBR
BlendMode: 0
AlphaCutoff: 0.5
Properties:
  - UniformName: u_Albedo
    DisplayName: Albedo Color
    Type: 4
    Vec3Value: [0.5, 0, 0]
  - UniformName: u_UseAlbedoMap
    DisplayName: Enable Albedo Map
    Type: 2
    BoolValue: false
  - UniformName: u_AlbedoMap
    DisplayName: Albedo Texture
    Type: 8
    TextureHandle: 0
  - UniformName: u_UseNormalMap
    DisplayName: Enable Normal Map
    Type: 2
    BoolValue: false
  - UniformName: u_NormalMap
    DisplayName: Normal Map
    Type: 8
    TextureHandle: 0
  - UniformName: u_Metallic
    DisplayName: Metallic
    Type: 0
    FloatValue: 0.6666667
  - UniformName: u_UseMetallicMap
    DisplayName: Enable Metallic Map
    Type: 2
    BoolValue: false
  - UniformName: u_MetallicMap
    DisplayName: Metallic Texture
    Type: 8
    TextureHandle: 0
  - UniformName: u_Roughness
    DisplayName: Roughness
    Type: 0
    FloatValue: 0.33333334
  - UniformName: u_UseRoughnessMap
    DisplayName: Enable Roughness Map
    Type: 2
    BoolValue: false
  - UniformName: u_RoughnessMap
    DisplayName: Roughness Texture
    Type: 8
    TextureHandle: 0
  - UniformName: u_AO
    DisplayName: Ambient Occlusion
    Type: 0
    FloatValue: 1
  - UniformName: u_UseAOMap
    DisplayName: Enable AO Map
    Type: 2
    BoolValue: false
  - UniformName: u_AOMap
    DisplayName: AO Texture
    Type: 8
    TextureHandle: 0
  - UniformName: u_Alpha
    DisplayName: Alpha Multiplier
    Type: 0
    FloatValue: 1
  - UniformName: u_AlphaMap
    DisplayName: Alpha/Opacity Map
    Type: 8
    TextureHandle: 0
  - UniformName: u_ORMMap
    DisplayName: ORM Texture (R=AO G=Roughness B=Metallic)
    Type: 8
    TextureHandle: 0
  - UniformName: u_HeightMap
    DisplayName: Height/Displacement Map
    Type: 8
    TextureHandle: 0
  - UniformName: u_EmissiveMap
    DisplayName: Emissive Map
    Type: 8
    TextureHandle: 0